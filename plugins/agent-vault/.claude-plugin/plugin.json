{
  "name": "agent-vault",
  "version": "0.12.0",
  "description": "Durable project memory under ~/agent-vault (overridable via AGENT_VAULT). Ten skills cover scaffold-only setup, knowledge and decision capture, journals, handoffs, retrieval, orientation, maintenance, and a bundled read-only viewer. Direct SQLite task helpers and hooks provide a startup resource map, verified commit linking, and supervised best-effort continuity capture.",
  "author": {
    "name": "David Colon",
    "email": "38386583+Da-Colon@users.noreply.github.com"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/bin/hook-session-start.sh\"",
            "statusMessage": "Orienting from Agent Vault"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/bin/hook-git-commit-link.sh\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/bin/hook-user-prompt-wrapup.sh\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/bin/hook-precompact-handoff.sh\"",
            "statusMessage": "Writing pre-compaction handoff to Agent Vault",
            "timeout": 300
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/bin/hook-sessionend-capture.sh\"",
            "statusMessage": "Capturing session to Agent Vault",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
