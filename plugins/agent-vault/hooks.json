{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/bin/hook-session-start.sh",
            "statusMessage": "Orienting from Agent Vault"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/bin/hook-git-commit-link.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/bin/hook-user-prompt-wrapup.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/bin/hook-precompact-handoff.sh",
            "statusMessage": "Writing pre-compaction handoff to Agent Vault",
            "timeout": 300
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/bin/hook-sessionend-capture.sh",
            "statusMessage": "Capturing session to Agent Vault",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
